<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen widget: what you played last, and a row of recent albums and playlists. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/om_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/om_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/om_widget_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/om_head"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/om_head_art"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/om_widget_placeholder" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/om_head_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/om_widget_recent"
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/om_head_sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/om_widget_recent_empty"
                    android:textColor="#CCFFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/om_logo"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="top"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/om_row"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView android:id="@+id/om_item1" style="@style/OmWidgetItem" />
            <ImageView android:id="@+id/om_item2" style="@style/OmWidgetItem" />
            <ImageView android:id="@+id/om_item3" style="@style/OmWidgetItem" />
            <ImageView android:id="@+id/om_item4" style="@style/OmWidgetItem" />
            <ImageView android:id="@+id/om_item5" style="@style/OmWidgetItem" android:layout_marginEnd="0dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
