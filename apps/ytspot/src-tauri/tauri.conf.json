{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YTSpot",
  "mainBinaryName": "YTSpot",
  "version": "1.2.2",
  "identifier": "app.openmusic.ytspot",
  "build": {
    "frontendDist": "../../../ui/dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "YTSpot",
        "width": 1320,
        "height": 840,
        "minWidth": 820,
        "minHeight": 560,
        "backgroundColor": "#121212",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "マッキニー マイヤ",
    "shortDescription": "YTSpot music player",
    "longDescription": "YTSpot - a Spotify-style desktop music client.",
    "category": "Music",
    "copyright": "© マッキニー マイヤ",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "languages": [
          "English",
          "Japanese"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
