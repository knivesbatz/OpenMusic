<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- A cover in the recently played row: it fills its share of the row and stays square
         (the bitmap is square), so covers grow and shrink with the widget. -->
    <style name="OmWidgetItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:src">@drawable/om_widget_placeholder</item>
    </style>
</resources>
