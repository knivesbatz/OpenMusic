{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenSpot",
  "mainBinaryName": "OpenSpot",
  "version": "2.3.2",
  "identifier": "app.openmusic.ytspot",
  "build": {
    "frontendDist": "../../../ui/dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "OpenSpot",
        "width": 1320,
        "height": 840,
        "minWidth": 820,
        "minHeight": 560,
        "backgroundColor": "#121212",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "マッキニー マイヤ",
    "shortDescription": "OpenSpot music player",
    "longDescription": "OpenSpot - a Spotify-style music client for YouTube Music, Plex and your own files.",
    "category": "Music",
    "copyright": "© マッキニー マイヤ",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "languages": [
          "English",
          "Japanese"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "installer/hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    }
  }
}
